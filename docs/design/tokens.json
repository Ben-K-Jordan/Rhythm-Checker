{
  "$description": "Rhythm Checker v3 design tokens, generated from webapp/css/base.css. Brand: photocopied gig poster. All text pairs meet WCAG AA (see docs/DESIGN.md).",
  "color": {
    "brand": {
      "paper": {
        "$type": "color",
        "$value": "#f2ecdd"
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "ink": {
        "$type": "color",
        "$value": "#141210"
      },
      "red": {
        "$type": "color",
        "$value": "#e0301e",
        "$description": "primary CTA fill + R hand. White text on it only at >= 24px"
      },
      "blue": {
        "$type": "color",
        "$value": "#2b4cf0",
        "$description": "L hand only"
      },
      "green": {
        "$type": "color",
        "$value": "#3a7d34",
        "$description": "inside your own tolerance / saved, always with a check or words"
      },
      "amber": {
        "$type": "color",
        "$value": "#e8b23a",
        "$description": "hazard, warn chip fill, toast action, focus on dark. Never data"
      }
    },
    "text-safe": {
      "red-ink": {
        "$type": "color",
        "$value": "#c8281a",
        "$description": "red text < 24px: 4.72 on paper, 5.56 on white"
      },
      "amber-ink": {
        "$type": "color",
        "$value": "#7a5a10",
        "$description": "any amber-coloured text: 5.40 on paper, 6.37 on white"
      },
      "green-ink": {
        "$type": "color",
        "$value": "#2f6a2a",
        "$description": "green text on paper: 5.54"
      }
    },
    "neutral": {
      "ink60": {
        "$type": "color",
        "$value": "#5a534a",
        "$description": "secondary text: 6.43 paper, 7.58 white, 5.62 cream3"
      },
      "tint": {
        "$type": "color",
        "$value": "#e9e2d0",
        "$description": "summary strip, pocket band, gauge track, window band"
      },
      "cream3": {
        "$type": "color",
        "$value": "#e6ddcb",
        "$description": "disabled fill"
      },
      "rule": {
        "$type": "color",
        "$value": "#cfc5ae",
        "$description": "hairlines, unlit meter bars (graphics only)"
      },
      "dot": {
        "$type": "color",
        "$value": "#8a857c",
        "$description": "graphics only: older hits (3.67 on white). Banned as text"
      },
      "dot-strong": {
        "$type": "color",
        "$value": "#6e685f",
        "$description": "in-pocket dots on tint (4.27 on tint)"
      }
    },
    "heat": {
      "heat1": {
        "$type": "color",
        "$value": "#a8a091"
      },
      "heat2": {
        "$type": "color",
        "$value": "#6b6458"
      },
      "heat3": {
        "$type": "color",
        "$value": "#141210",
        "$description": "ordinal ramp"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Anton",
          "Arial Narrow",
          "sans-serif"
        ]
      },
      "label": {
        "$type": "fontFamily",
        "$value": [
          "Oswald",
          "Arial Narrow",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Space Mono",
          "ui-monospace",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "masthead": {
        "$type": "dimension",
        "$value": "88px",
        "$description": "Start only, Anton"
      },
      "monitor": {
        "$type": "dimension",
        "$value": "120px",
        "$description": "live number, Space Mono 700, <=3 glyphs"
      },
      "monitor-4": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "4 glyphs"
      },
      "monitor-5": {
        "$type": "dimension",
        "$value": "72px",
        "$description": "5+ glyphs"
      },
      "countin": {
        "$type": "dimension",
        "$value": "120px",
        "$description": "count-in digit"
      },
      "hero": {
        "$type": "dimension",
        "$value": "88px",
        "$description": "result number, Space Mono 700"
      },
      "hub": {
        "$type": "dimension",
        "$value": "44px",
        "$description": "Home RUDIMENTS tile, Anton"
      },
      "dir": {
        "$type": "dimension",
        "$value": "30px",
        "$description": "EARLY/LATE/SHARP/FLAT word beside a monitor, Anton"
      },
      "title": {
        "$type": "dimension",
        "$value": "30px",
        "$description": "screen title stamp, Anton"
      },
      "cta": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "primary button, Anton"
      },
      "tile-name": {
        "$type": "dimension",
        "$value": "26px",
        "$description": "Home module tile, Anton"
      },
      "unit": {
        "$type": "dimension",
        "$value": "22px",
        "$description": "\"ms\" beside monitor/hero, Oswald 600"
      },
      "avg": {
        "$type": "dimension",
        "$value": "22px",
        "$description": "\"AVG 8.8 ms EARLY\" line, Oswald 700"
      },
      "stat": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "3-up tile value, Space Mono 700"
      },
      "stat-4": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "4-up tile value"
      },
      "btn2": {
        "$type": "dimension",
        "$value": "19px",
        "$description": "secondary button, Anton"
      },
      "run": {
        "$type": "dimension",
        "$value": "17px",
        "$description": "LIVE banner text, Oswald 700"
      },
      "control": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "segments, summary strip, chip buttons, nav, Oswald 700"
      },
      "body": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "hints, what-for lines, toasts, Space Mono 400"
      },
      "label": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "tile labels, section stamps, Oswald 600"
      },
      "caption": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "sub-lines, meta, Space Mono 400"
      },
      "axis": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "chart ticks, footnotes: the floor"
      }
    }
  },
  "space": {
    "s1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "s2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "s3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "s4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "s6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "s8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "16px"
    },
    "hit": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "fixed heights (no flex:1 anywhere)"
    }
  },
  "size": {
    "h-header": {
      "$type": "dimension",
      "$value": "52px"
    },
    "h-hazard": {
      "$type": "dimension",
      "$value": "8px"
    },
    "h-title": {
      "$type": "dimension",
      "$value": "44px"
    },
    "h-summary": {
      "$type": "dimension",
      "$value": "44px"
    },
    "h-seg": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "2px frame + 44px buttons"
    },
    "h-btn": {
      "$type": "dimension",
      "$value": "64px"
    },
    "h-btn2": {
      "$type": "dimension",
      "$value": "52px"
    },
    "h-highway-run": {
      "$type": "dimension",
      "$value": "220px"
    },
    "h-highway-idle": {
      "$type": "dimension",
      "$value": "156px"
    },
    "h-strip": {
      "$type": "dimension",
      "$value": "88px"
    },
    "h-chart": {
      "$type": "dimension",
      "$value": "200px"
    },
    "h-gauge": {
      "$type": "dimension",
      "$value": "176px"
    },
    "h-heat": {
      "$type": "dimension",
      "$value": "154px"
    },
    "h-trend": {
      "$type": "dimension",
      "$value": "120px",
      "$description": "borders + elevation (zero blur)"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "shadow": {
    "ctl": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.ink}",
        "offsetX": "2px",
        "offsetY": "2px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "zero blur: the poster's hard offset shadow"
    },
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.ink}",
        "offsetX": "3px",
        "offsetY": "3px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "zero blur: the poster's hard offset shadow"
    },
    "cta": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.ink}",
        "offsetX": "5px",
        "offsetY": "5px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "zero blur: the poster's hard offset shadow"
    },
    "poster": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.ink}",
        "offsetX": "6px",
        "offsetY": "6px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "zero blur: the poster's hard offset shadow"
    },
    "hub": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.red}",
        "offsetX": "6px",
        "offsetY": "6px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "zero blur: the poster's hard offset shadow"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "the only tween: summary collapse, disclosure open"
    },
    "hold": {
      "$type": "duration",
      "$value": "600ms",
      "$description": "hold-to-confirm"
    },
    "toast": {
      "$type": "duration",
      "$value": "6000ms"
    },
    "stale": {
      "$type": "duration",
      "$value": "8000ms",
      "$description": "tuner reading fades after this"
    },
    "hazard": {
      "$type": "duration",
      "$value": "900ms",
      "$description": "one stripe period while LIVE"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.0,
        0.0,
        1.0
      ]
    }
  }
}